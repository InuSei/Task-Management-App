# Copy this file to .env.local and fill in your own values. .env.local is git-ignored.

# MongoDB connection string, e.g. from MongoDB Atlas (Database > Connect > Drivers).
MONGODB_URI=

# Database name (optional, defaults to "task-manager").
MONGODB_DB=task-manager

# Set to "local" to skip the database and keep data in this browser only.
# NEXT_PUBLIC_STORAGE=local
